{
  "name": "steamguard",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:mac": "tauri build --bundles app,dmg",
    "build:win": "tauri build --bundles nsis,msi",
    "build:android": "node scripts/mobile.mjs android build --apk",
    "build:ios": "node scripts/mobile.mjs ios build",
    "build:ios:sim": "node scripts/mobile.mjs ios build --target aarch64-sim --debug",
    "init:android": "node scripts/mobile.mjs android init",
    "init:ios": "node scripts/mobile.mjs ios init",
    "test:ui": "playwright test",
    "package:ios:ipa": "node scripts/package-ios-ipa.mjs",
    "build:ios:ipa": "npm run build:ios -- --no-sign --archive-only --ci && npm run package:ios:ipa",
    "test:release": "node --test tests/release.test.mjs tests/release-notes.test.mjs tests/release-maintenance.test.mjs",
    "test:i18n": "node scripts/i18n.mjs check && node --test tests/i18n.test.mjs",
    "i18n:check": "node scripts/i18n.mjs check"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "2.5.3",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "26.7.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "17.1.11",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
