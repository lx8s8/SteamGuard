{
  "name": "steamguard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:mac": "tauri build --bundles app,dmg",
    "build:win": "tauri build --bundles nsis,msi",
    "build:android": "node scripts/mobile.mjs android build --apk",
    "build:ios": "node scripts/mobile.mjs ios build",
    "build:ios:sim": "node scripts/mobile.mjs ios build --target aarch64-sim --debug",
    "init:android": "node scripts/mobile.mjs android init",
    "init:ios": "node scripts/mobile.mjs ios init",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.5",
    "@playwright/test": "^1.58.0"
  }
}
