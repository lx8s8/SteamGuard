<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:background="@drawable/steamguard_widget_background">
 <TextView android:id="@+id/entry_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SteamGuard" android:textColor="#202124" android:textSize="17sp" android:textStyle="bold" android:paddingBottom="6dp" />
 <LinearLayout android:id="@+id/entry_list" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
 <TextView android:id="@+id/entry_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:text="@string/steamguard_entry_open" android:textSize="14sp" android:textColor="#5150CF" />
</LinearLayout>
